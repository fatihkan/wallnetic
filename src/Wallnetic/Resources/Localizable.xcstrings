    "That display is no longer connected. Choose a connected display and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Display ist nicht mehr verbunden. Wähle ein verbundenes Display und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet écran n’est plus connecté. Choisissez un écran connecté et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "そのディスプレイは接続されていません。接続中のディスプレイを選択して、やり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "该显示器已断开连接。请选取一台已连接的显示器，然后重试。"
          }
        }
      }
    },
    "That video is no longer in the library. Refresh the library and choose another wallpaper.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Video ist nicht mehr in der Mediathek. Aktualisiere die Mediathek und wähle ein anderes Hintergrundbild."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette vidéo n’est plus dans la bibliothèque. Actualisez la bibliothèque et choisissez un autre fond d’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "そのビデオはライブラリにありません。ライブラリを更新して、別の壁紙を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "该视频已不在资料库中。请刷新资料库并选取其他壁纸。"
          }
        }
      }
    },
    "The Mac slept or the login session changed. Saved choices need reassignment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Mac war im Ruhezustand oder die Anmeldesitzung hat sich geändert. Gesicherte Auswahlen müssen neu zugewiesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Mac a été suspendu ou la session a changé. Les choix enregistrés doivent être réattribués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macがスリープしたか、ログインセッションが変わりました。保存した選択の再割り当てが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac 已睡眠或登录会话已更改。需要重新分配已保存的选择。"
          }
        }
      }
    },
    "The active desktop changed. Saved choices need reassignment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der aktive Schreibtisch hat sich geändert. Gesicherte Auswahlen müssen neu zugewiesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le bureau actif a changé. Les choix enregistrés doivent être réattribués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アクティブなデスクトップが変わりました。保存した選択の再割り当てが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "活跃桌面已更改。需要重新分配已保存的选择。"
          }
        }
      }
    },
    "The converted video failed verification. No copy was added; your original is unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das konvertierte Video hat die Überprüfung nicht bestanden. Es wurde keine Kopie hinzugefügt; dein Original ist unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vidéo convertie n’a pas passé la vérification. Aucune copie n’a été ajoutée ; votre original n’est pas modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変換したビデオを検証できませんでした。コピーは追加されておらず、オリジナルは変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "转换后的视频未通过验证。未添加副本；你的原始视频未更改。"
          }
        }
      }
    },
    "The day is full. Shorten or remove a range to make room for another.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Tag ist voll. Kürze oder entferne einen Zeitraum, um Platz für einen weiteren zu schaffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La journée est complète. Raccourcissez ou supprimez une plage pour en ajouter une autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1日がすべて埋まっています。別の時間帯を追加するには、時間帯を短くするか削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "全天已排满。请缩短或移除一个时间段，以便为新的时间段留出位置。"
          }
        }
      }
    },
    "The display setup changed. Saved choices need reassignment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Display-Anordnung hat sich geändert. Gesicherte Auswahlen müssen neu zugewiesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configuration des écrans a changé. Les choix enregistrés doivent être réattribués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ディスプレイの構成が変わりました。保存した選択の再割り当てが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "显示器设置已更改。需要重新分配已保存的选择。"
          }
        }
      }
    },
    "The download could not be completed. Check your connection and retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Download konnte nicht abgeschlossen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le téléchargement n’a pas pu être terminé. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ダウンロードを完了できませんでした。接続を確認して、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法完成下载。请检查网络连接，然后重试。"
          }
        }
      }
    },
    "The dropped file could not be read. Try importing it with the file picker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die abgelegte Datei konnte nicht gelesen werden. Importiere sie über den Dateiauswahldialog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de lire le fichier déposé. Essayez de l’importer avec le sélecteur de fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ドロップしたファイルを読み込めませんでした。ファイル選択ダイアログから読み込んでみてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法读取拖入的文件。请尝试通过文件选择器导入。"
          }
        }
      }
    },
    "The encoder did not complete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Encoder wurde nicht fertig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’encodeur n’a pas terminé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エンコーダが処理を完了できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "编码器未能完成。"
          }
        }
      }
    },
    "The file or its folder changed. Refresh and select it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Datei oder ihr Ordner wurde geändert. Aktualisiere und wähle sie erneut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le fichier ou son dossier a changé. Actualisez et sélectionnez-le de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイルまたはそのフォルダが変更されました。更新して、もう一度選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文件或其所在文件夹已更改。请刷新后重新选择。"
          }
        }
      }
    },
    "The heat hold clears after one minute of cooling, or when thermal-aware playback is turned off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Wärmepause endet nach einer Minute Abkühlung oder wenn die temperaturabhängige Wiedergabe deaktiviert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pause due à la chaleur prend fin après une minute de refroidissement, ou lorsque la lecture adaptée à la température est désactivée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "熱による静止は、1分間冷却するか、“温度に応じた再生”をオフにすると解除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "降温一分钟后，或关闭温控播放后，过热暂停会解除。"
          }
        }
      }
    },
    "The last frame stays visible when time runs out. Play, a wallpaper change, or an allowed resume after unlock starts a new interval. Manual Pause stays paused until you press Play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn die Zeit abläuft, bleibt das letzte Bild sichtbar. „Wiedergeben“, ein Wechsel des Hintergrundbilds oder ein erlaubtes Fortsetzen nach dem Entsperren startet ein neues Intervall. Eine manuelle Pause bleibt bestehen, bis du „Wiedergeben“ drückst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dernière image reste visible une fois le délai écoulé. La lecture, un changement de fond d’écran ou une reprise autorisée après le déverrouillage lance un nouvel intervalle. Une pause manuelle dure jusqu’à ce que vous appuyiez sur Lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "時間切れになると、最後のフレームが表示されたままになります。再生する、壁紙を変更する、またはロック解除後に再開が許可されると、新しい間隔が始まります。手動で一時停止した場合は、“再生”を押すまで一時停止のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "时间用完后，最后一帧会保持显示。按“播放”、更换壁纸，或解锁后获准继续播放时，会重新开始计时。手动暂停会一直保持，直到你按“播放”。"
          }
        }
      }
    },
    "The library directory is unavailable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Ordner der Mediathek ist nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le dossier de la bibliothèque est indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ライブラリのディレクトリを利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "资料库目录不可用。"
          }
        }
      }
    },
    "The library disk ran out of space during conversion. Free some space and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf dem Volume der Mediathek ging während der Konvertierung der Speicherplatz aus. Gib Speicherplatz frei und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le disque de la bibliothèque a manqué d’espace pendant la conversion. Libérez de l’espace et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変換中にライブラリのディスクの空き領域がなくなりました。空き領域を増やして、やり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "转换过程中资料库所在磁盘空间不足。请释放一些空间，然后重试。"
          }
        }
      }
    },
    "The original file is not changed. Each step moves to the next or previous frame; a loop is at least one second long.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Originaldatei wird nicht geändert. Jeder Schritt springt zum nächsten oder vorherigen Einzelbild; eine Schleife ist mindestens eine Sekunde lang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le fichier d’origine n’est pas modifié. Chaque incrément passe à l’image suivante ou précédente ; une boucle dure au moins une seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元のファイルは変更されません。1ステップごとに次または前のフレームに移動します。ループの長さは1秒以上です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "原始文件不会更改。每一步移到下一帧或上一帧；循环的长度至少为一秒。"
          }
        }
      }
    },
    "The original file is not changed. Steps use the video's shortest frame interval; a loop is at least one second long.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Originaldatei wird nicht geändert. Schritte verwenden den kürzesten Bildabstand des Videos; eine Schleife ist mindestens eine Sekunde lang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le fichier d’origine n’est pas modifié. Les incréments utilisent le plus court intervalle entre deux images de la vidéo ; une boucle dure au moins une seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元のファイルは変更されません。ステップにはビデオの最短フレーム間隔が使われます。ループの長さは1秒以上です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "原始文件不会更改。每一步采用视频的最短帧间隔；循环的长度至少为一秒。"
          }
        }
      }
    },
    "The previous start times were invalid or out of order. Default times were restored; all wallpaper selections were kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die bisherigen Startzeiten waren ungültig oder nicht in der richtigen Reihenfolge. Die Standardzeiten wurden wiederhergestellt; alle ausgewählten Hintergrundbilder bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les heures de début précédentes n’étaient pas valides ou étaient dans le désordre. Les heures par défaut ont été rétablies ; tous les fonds d’écran choisis ont été conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以前の開始時刻が無効か、順序が正しくありませんでした。デフォルトの時刻に戻しました。壁紙の選択はすべて残してあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "之前的开始时间无效或顺序有误。已恢复默认时间；所有壁纸选择均已保留。"
          }
        }
      }
    },
    "The range could not be saved: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bereich konnte nicht gesichert werden: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’enregistrer la plage : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "範囲を保存できませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法保存该范围：%@"
          }
        }
      }
    },
    "The saved choice could not be updated.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die gesicherte Auswahl konnte nicht aktualisiert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de mettre à jour le choix enregistré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存した選択を更新できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法更新已保存的选择。"
          }
        }
      }
    },
    "The saved range does not match this file and is not applied. Saving replaces it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der gesicherte Bereich passt nicht zu dieser Datei und wird nicht angewendet. Beim Sichern wird er ersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La plage enregistrée ne correspond pas à ce fichier et n’est pas appliquée. L’enregistrement la remplace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存されている範囲はこのファイルと一致しないため、適用されていません。保存すると置き換えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已保存的范围与此文件不匹配，因此未应用。保存会将其替换。"
          }
        }
      }
    },
    "The slideshow has been added to your library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Diashow wurde zu deiner Mediathek hinzugefügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le diaporama a été ajouté à votre bibliothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スライドショーがライブラリに追加されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "幻灯片已添加到你的资料库。"
          }
        }
      }
    },
    "The source video is missing or changed. Refresh the library and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Quellvideo fehlt oder wurde geändert. Aktualisiere die Mediathek und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vidéo source est manquante ou a été modifiée. Actualisez la bibliothèque et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ソースビデオが見つからないか、変更されています。ライブラリを更新して、やり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "源视频缺失或已更改。请刷新资料库，然后重试。"
          }
        }
      }
    },
    "The unreadable settings will be kept as a backup. Library media will stay unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die nicht lesbaren Einstellungen bleiben als Backup erhalten. Die Medien in der Mediathek bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les réglages illisibles seront conservés comme sauvegarde. Les médias de la bibliothèque ne seront pas modifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "読み込めない設定はバックアップとして保存されます。ライブラリのメディアは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法读取的设置会保留为备份。资料库中的媒体不会更改。"
          }
        }
      }
    },
    "The video could not be loaded. Retry, or choose another wallpaper.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Video konnte nicht geladen werden. Versuche es erneut oder wähle ein anderes Hintergrundbild."
