    "Conversion stopped, but temporary files could not be removed. Check the library disk and remove the temporary .optimization folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Konvertierung wurde gestoppt, aber temporäre Dateien konnten nicht entfernt werden. Prüfe das Volume der Mediathek und entferne den temporären Ordner „.optimization“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La conversion s’est arrêtée, mais les fichiers temporaires n’ont pas pu être supprimés. Vérifiez le disque de la bibliothèque et supprimez le dossier temporaire .optimization."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変換は停止しましたが、一時ファイルを削除できませんでした。ライブラリのディスクを確認し、一時フォルダ“.optimization”を削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "转换已停止，但无法移除临时文件。请检查资料库所在磁盘，并移除临时的 .optimization 文件夹。"
