        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal : jusqu’à 30 images par seconde pour la lecture au quotidien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal：最大30フレーム／秒。普段の再生に適しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal：最高每秒 30 帧，适合日常播放。"
          }
        }
      }
    },
    "Metal: up to 60 frames per second for smoother motion.": {
      "localizations": {
        "de": {
