    "Lower resolution and fewer frames. Fine detail and motion smoothness may decrease.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niedrigere Auflösung und weniger Bilder. Feine Details und flüssige Bewegung können abnehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Résolution plus basse et moins d’images. Les détails fins et la fluidité du mouvement peuvent diminuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "解像度とフレーム数を下げます。細部や動きの滑らかさが低下することがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分辨率更低、帧数更少。精细细节和画面流畅度可能下降。"
          }
        }
      }
    },
