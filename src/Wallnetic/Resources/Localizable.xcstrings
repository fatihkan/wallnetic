    "%@ (%@). This permanently removes the app-managed copy and its assignments. Your original source file is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (%@). Die von der App verwaltete Kopie und ihre Zuweisungen werden dauerhaft entfernt. Deine Originaldatei bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@). This permanently removes the app-managed copy and its assignments. Your original source file is kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ (%@). Cette opération supprime définitivement la copie gérée par l’app et ses attributions. Votre fichier source d’origine est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@（%@）。アプリ管理のコピーとその割り当てを完全に削除します。元のソースファイルは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@（%@）。此操作会永久移除 App 管理的副本及其分配。你的原始源文件会保留。"
          }
        }
      }
    },
    "%@ API key not configured": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "API-Schlüssel für %@ nicht konfiguriert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clé API %@ non configurée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@のAPIキーが設定されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未配置 %@ API 密钥"
          }
        }
      }
    },
    "%@ is in your library. Choose a wallpaper to play it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ist in deiner Mediathek. Wähle ein Hintergrundbild aus, um es wiederzugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se trouve dans votre bibliothèque. Choisissez un fond d’écran pour le lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”はライブラリにあります。再生する壁紙を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”已在你的资料库中。选取一张壁纸即可播放。"
          }
        }
      }
    },
