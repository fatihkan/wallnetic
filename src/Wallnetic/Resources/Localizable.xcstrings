          }
        }
      }
    },
    "This applies when more than one display is connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gilt, wenn mehr als ein Display verbunden ist."
          }
        },
        "fr": {
