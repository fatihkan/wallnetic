    "Unused widget thumbnails can be cleared. System wallpaper images, current thumbnails and the search index are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unbenutzte Widget-Miniaturen können gelöscht werden. System-Hintergrundbilder, aktuelle Miniaturen und der Suchindex bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les vignettes de widgets inutilisées peuvent être effacées. Les images de fond d’écran du système, les vignettes actuelles et l’index de recherche sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未使用のウィジェットのサムネールを消去できます。システムの壁紙イメージ、現在のサムネール、検索インデックスは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可以清除未使用的小组件缩略图。系统壁纸图像、当前缩略图和搜索索引会保留。"
          }
        }
      }
    },
