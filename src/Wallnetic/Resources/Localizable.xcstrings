    },
    "Automatic per-Space switching is unavailable because individual desktops cannot be reliably identified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatisches Wechseln pro Space ist nicht verfügbar, da einzelne Schreibtische nicht zuverlässig erkannt werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le changement automatique par Space est indisponible, car chaque bureau ne peut pas être identifié de façon fiable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "個々のデスクトップを確実に識別できないため、操作スペースごとの自動切り替えは利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法可靠识别各个桌面，因此不支持按空间自动切换。"
          }
        }
      }
    },
    "Automatically rotate wallpapers": {
