    "This Mac does not provide HEVC hardware encoding and decoding for this size. Choose H.264.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Mac bietet für diese Größe keine HEVC-Hardwarecodierung und -decodierung. Wähle H.264."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce Mac ne propose pas l’encodage et le décodage matériels HEVC pour cette taille. Choisissez H.264."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このMacは、このサイズでのHEVCのハードウェアエンコードとデコードに対応していません。H.264を選択してください。"
          }
        },
        "zh-Hans": {
