    "Downloads add library copies without starting playback. Closing this window keeps the current download running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads fügen der Mediathek Kopien hinzu, ohne die Wiedergabe zu starten. Wenn du dieses Fenster schließt, läuft der aktuelle Download weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les téléchargements ajoutent des copies à la bibliothèque sans lancer la lecture. Si vous fermez cette fenêtre, le téléchargement en cours se poursuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ダウンロードするとライブラリにコピーが追加されますが、再生は始まりません。このウインドウを閉じても、進行中のダウンロードは続きます。"
          }
        },
        "zh-Hans": {
