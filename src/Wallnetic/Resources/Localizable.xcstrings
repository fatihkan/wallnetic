    },
    "Start and End must be inside the video, with Start before End.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start und Ende müssen innerhalb des Videos liegen, Start vor Ende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le début et la fin doivent se situer dans la vidéo, le début précédant la fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開始と終了はビデオの範囲内にし、開始を終了より前にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "开始和结束位置必须在视频范围内，且开始须早于结束。"
          }
        }
      }
    },
    "Start with a video you love. Add it to your library, then set it as your live wallpaper.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beginne mit einem Video, das dir gefällt. Füge es deiner Mediathek hinzu und lege es dann als Live-Hintergrund fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commencez par une vidéo que vous aimez. Ajoutez-la à votre bibliothèque, puis définissez-la comme fond d’écran animé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "好きなビデオから始めましょう。ライブラリに追加してから、ライブ壁紙に設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从一个你喜欢的视频开始。将它添加到资料库，然后设为动态壁纸。"
          }
        }
      }
    },
