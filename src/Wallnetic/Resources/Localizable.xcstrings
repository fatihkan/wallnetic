    "Choose a wallpaper for each display above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle oben für jedes Display ein Hintergrundbild."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
