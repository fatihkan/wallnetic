    "Available disk space could not be checked. Check the library disk and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der verfügbare Speicherplatz konnte nicht geprüft werden. Prüfe das Volume der Mediathek und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de vérifier l’espace disque disponible. Vérifiez le disque de la bibliothèque et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ディスクの空き領域を確認できませんでした。ライブラリのディスクを確認して、やり直してください。"
          }
        },
        "zh-Hans": {
