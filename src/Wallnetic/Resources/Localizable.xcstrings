    "Allow Wallnetic in Login Items to finish enabling launch at login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube Wallnetic in den Anmeldeobjekten, um das Öffnen bei der Anmeldung zu aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez Wallnetic dans les réglages Ouverture pour terminer l’activation de l’ouverture à la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ログイン時の起動を有効にするには、“ログイン項目”でWallneticを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“登录项”中允许 Wallnetic，以完成启用“登录时打开”。"
          }
        }
      }
    },
    "Allow access to Photos to create slideshows from your library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube den Zugriff auf Fotos, um Diashows aus deiner Mediathek zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez l’accès à Photos pour créer des diaporamas à partir de votre photothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ライブラリからスライドショーを作成するには、“写真”へのアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许访问“照片”，以便用你的图库创建幻灯片。"
          }
        }
      }
    },
    "Also available from the menu bar (⌘⇧M while Wallnetic is active) and Shortcuts on macOS 14 or later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auch über die Menüleiste (⌘⇧M, wenn Wallnetic aktiv ist) und ab macOS 14 über Kurzbefehle verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Également disponible dans la barre des menus (⌘⇧M lorsque Wallnetic est au premier plan) et dans Raccourcis sous macOS 14 ou ultérieur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メニューバー（Wallneticがアクティブなときは⌘⇧M）からも利用できます。macOS 14以降では“ショートカット”からも利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "也可从菜单栏使用（Wallnetic 处于活跃状态时按 ⌘⇧M）；在 macOS 14 或更高版本上还可通过“快捷指令”使用。"
          }
        }
      }
    },
    "Always play on battery (skip prompt)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Im Batteriebetrieb immer wiedergeben (ohne Nachfrage)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours lire sur batterie (sans alerte)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バッテリー駆動時も常に再生（確認を省略）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用电池时始终播放（跳过提示）"
          }
        }
      }
    },
    "Always use dark mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Immer Dunkelmodus verwenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours utiliser le mode sombre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "常にダークモードを使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "始终使用深色模式"
          }
        }
      }
    },
    "Always use light mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Immer hellen Modus verwenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours utiliser le mode clair"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "常にライトモードを使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "始终使用浅色模式"
          }
        }
      }
    },
    "An enabled daily schedule or playlist holds a manual choice for 30 minutes, then resumes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein aktivierter täglicher Zeitplan oder eine aktivierte Playlist behält eine manuelle Auswahl 30 Minuten bei und läuft dann weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si les horaires quotidiens ou la playlist sont activés, un choix manuel est conservé 30 minutes, puis ils reprennent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "毎日のスケジュールまたはプレイリストが有効な場合、手動で選んだ壁紙を30分間維持してから再開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已启用的每日时间表或播放列表会将手动选择保持 30 分钟，然后恢复。"
          }
        }
      }
    },
    "An end time before the start crosses midnight. Use 00:00–24:00 for a full day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Endzeit vor der Startzeit reicht über Mitternacht. Verwende 00:00–24:00 für einen ganzen Tag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une heure de fin antérieure à l’heure de début fait passer la plage par minuit. Utilisez 00:00–24:00 pour une journée entière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終了時刻が開始時刻より前の場合は、日付をまたぎます。終日にするには00:00〜24:00を使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "结束时间早于开始时间表示跨越午夜。全天请使用 00:00–24:00。"
          }
        }
      }
    },
    "Anamorphic video is not supported by these presets. Keep using the original.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anamorphe Videos werden von diesen Voreinstellungen nicht unterstützt. Verwende weiter das Original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces préréglages ne prennent pas en charge la vidéo anamorphique. Continuez d’utiliser l’original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらのプリセットはアナモルフィックビデオに対応していません。オリジナルを引き続き使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些预设不支持变形宽银幕视频。请继续使用原始视频。"
          }
        }
      }
    },
    "Anime": {
      "shouldTranslate": false
    },
    "Anime and general live wallpapers": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anime und allgemeine Live-Hintergründe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fonds d’écran animés : anime et thèmes variés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アニメと一般のライブ壁紙"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "动漫和综合类动态壁纸"
          }
        }
      }
    },
    "Another video is being optimized. Wait for it to finish or cancel it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein anderes Video wird gerade optimiert. Warte, bis es fertig ist, oder brich es zuerst ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une autre vidéo est en cours d’optimisation. Attendez qu’elle se termine ou annulez-la d’abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "別のビデオを最適化中です。完了を待つか、先にキャンセルしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在优化另一个视频。请等待其完成，或先将其取消。"
          }
        }
      }
    },
    "App-wide behavior and library location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App-weites Verhalten und Speicherort der Mediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comportement de l’app et emplacement de la bibliothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アプリ全体の動作とライブラリの場所。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App 整体行为和资料库位置。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Darstellung"
          }
        },
        "fr": {
