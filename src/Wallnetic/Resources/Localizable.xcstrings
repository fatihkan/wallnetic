    "Use 1–86,400 seconds (up to 24 hours). The video loops for this duration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwende 1–86.400 Sekunden (bis zu 24 Stunden). Das Video läuft für diese Dauer in Schleife."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez 1 à 86 400 secondes (jusqu’à 24 heures). La vidéo est lue en boucle pendant cette durée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1〜86,400秒（最大24時間）で指定してください。この時間の間、ビデオがループ再生されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请使用 1–86,400 秒（最长 24 小时）。视频会在此时长内循环播放。"
          }
        }
      }
    },
    "Use Default": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Standard verwenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Par défaut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デフォルトを使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用默认"
          }
        }
      }
    },
    "Use Default follows the global interval. Never Pause keeps this wallpaper moving regardless of the default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Standard verwenden“ folgt dem globalen Intervall. „Nie pausieren“ hält dieses Hintergrundbild unabhängig vom Standard in Bewegung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Par défaut » suit l’intervalle global. « Jamais de pause » laisse ce fond d’écran animé, quel que soit le réglage par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“デフォルトを使用”では全体の間隔に従います。“一時停止しない”では、デフォルトに関係なくこの壁紙が動き続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“使用默认”会沿用全局时长。“永不暂停”会让此壁纸持续播放，不受默认设置影响。"
          }
        }
      }
    },
