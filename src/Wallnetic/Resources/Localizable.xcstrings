    "Adds a removable copy to Library. Your own videos stay untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügt der Mediathek eine entfernbare Kopie hinzu. Deine eigenen Videos bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoute une copie supprimable à la bibliothèque. Vos propres vidéos ne sont pas modifiées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "削除可能なコピーをライブラリに追加します。お手持ちのビデオは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
