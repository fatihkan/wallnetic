    "HDR, transparency and color-tagged formats other than SDR Rec.709 are not supported by these presets. Keep using the original video.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HDR, Transparenz und Formate mit anderen Farb-Tags als SDR Rec.709 werden von diesen Voreinstellungen nicht unterstützt. Verwende weiter das Originalvideo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces préréglages ne prennent pas en charge le HDR, la transparence ni les formats de couleur autres que SDR Rec.709. Continuez d’utiliser la vidéo d’origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらのプリセットは、HDR、透明度、およびSDR Rec.709以外のカラータグ付きフォーマットに対応していません。オリジナルのビデオを引き続き使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些预设不支持 HDR、透明以及 SDR Rec.709 以外的带颜色标记的格式。请继续使用原始视频。"
          }
        }
      }
    },
    "HEVC hardware encoding/decoding is unavailable for this video size. Choose H.264.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEVC-Hardwarecodierung/-decodierung ist für diese Videogröße nicht verfügbar. Wähle H.264."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’encodage/décodage matériel HEVC est indisponible pour cette taille de vidéo. Choisissez H.264."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このビデオサイズではHEVCのハードウェアエンコード／デコードを利用できません。H.264を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此视频尺寸无法使用 HEVC 硬件编码/解码。请选取 H.264。"
          }
        }
      }
    },
    "HEVC · 1080p · up to 30 fps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEVC · 1080p · bis zu 30 fps"
          }
