    },
    "This catalog is unsupported or failed validation. The previous catalog is still available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Katalog wird nicht unterstützt oder hat die Überprüfung nicht bestanden. Der vorherige Katalog ist weiterhin verfügbar."
          }
        },
        "fr": {
