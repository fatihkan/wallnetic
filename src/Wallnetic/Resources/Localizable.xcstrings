    "Metal provides better GPU acceleration. Restart app after changing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal bietet bessere GPU-Beschleunigung. Starte die App nach dem Ändern neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal offre une meilleure accélération GPU. Redémarrez l’app après la modification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MetalではGPUアクセラレーションがより効果的に働きます。変更後はアプリを再起動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal 提供更好的 GPU 加速。更改后请重新启动 App。"
          }
        }
      }
    },
    "Metal renderer uses GPU for video playback (recommended)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Metal-Renderer nutzt die GPU für die Videowiedergabe (empfohlen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le moteur de rendu Metal utilise le GPU pour la lecture vidéo (recommandé)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metalレンダラはビデオの再生にGPUを使用します（推奨）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal 渲染器使用 GPU 播放视频（推荐）"
          }
        }
      }
    },
    "Metal: up to 15 frames per second with less fluid motion.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal: bis zu 15 Bilder pro Sekunde bei weniger flüssiger Bewegung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal : jusqu’à 15 images par seconde, avec un mouvement moins fluide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal：最大15フレーム／秒。動きの滑らかさは下がります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal：最高每秒 15 帧，画面流畅度较低。"
          }
        }
      }
    },
    "Metal: up to 30 frames per second for everyday playback.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metal: bis zu 30 Bilder pro Sekunde für die alltägliche Wiedergabe."
