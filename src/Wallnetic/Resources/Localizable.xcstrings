    "%@ overlaps %@. Move a boundary or choose a different time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ überschneidet sich mit %@. Verschiebe eine Grenze oder wähle eine andere Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ overlaps %2$@. Move a boundary or choose a different time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ chevauche %@. Déplacez une limite ou choisissez une autre heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”が“%@”と重なっています。境界を動かすか、別の時刻を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”与“%@”重叠。请移动边界或选取其他时间。"
