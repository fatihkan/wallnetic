    "Counted from the last key press, click or pointer movement. Playback continues at the next one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gezählt ab dem letzten Tastendruck, Klick oder der letzten Zeigerbewegung. Beim nächsten wird die Wiedergabe fortgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
